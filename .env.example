# Postgres connection string
DATABASE_URL=postgres://club:club@localhost:5432/club

# Long random string used to sign admin login sessions.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Where uploaded photos and documents are stored
UPLOAD_DIR=./data/uploads

# Public address of the site. Used to print the first-admin setup link on startup.
SITE_URL=http://localhost:3000

# Optional: enables the /api/seed import endpoints (32+ characters).
SEED_API_TOKEN=
