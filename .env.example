# Postgres connection string
DATABASE_URL=postgres://club:club@localhost:5432/club

# Long random string used to sign admin login sessions.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string

# Where uploaded photos and documents are stored
UPLOAD_DIR=./data/uploads

# Public address of the site. Used to print the first-admin setup link on startup.
SITE_URL=http://localhost:3000

# Optional: enables the /api/seed import endpoints (32+ characters).
SEED_API_TOKEN=

# Optional: outgoing email through an SMTP provider (see README "Email").
# Purelymail: SMTP_HOST=smtp.purelymail.com, SMTP_PORT=465, login = the full mailbox address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown on emails, e.g. "Utah Valley Aeromodelers <noreply@example-club.org>"
EMAIL_FROM=
# Optional: where replies go, if not the From address
EMAIL_REPLY_TO=
# Optional test mode: send every email to this one address instead of the real recipients
EMAIL_REDIRECT_TO=
