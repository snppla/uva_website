# Copy to .env on the server and fill in. Generate secrets with: openssl rand -base64 32

# Cloudflare Tunnel token (Zero Trust dashboard → Networks → Tunnels → your tunnel)
TUNNEL_TOKEN=

POSTGRES_PASSWORD=
SESSION_SECRET=

# Public address of the site, e.g. https://example-club.org
# Used to print the first-admin setup link in the logs.
SITE_URL=
