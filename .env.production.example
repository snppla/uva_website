# Copy to .env on the server and fill in. Generate secrets with: openssl rand -base64 32

# Cloudflare Tunnel token (Zero Trust dashboard → Networks → Tunnels → your tunnel)
TUNNEL_TOKEN=

POSTGRES_PASSWORD=
SESSION_SECRET=

# Public address of the site, e.g. https://example-club.org
# Used to print the first-admin setup link in the logs, and for link previews
# (set at build time, so rebuild after changing it).
SITE_URL=

# Only while importing content with `npm run seed:remote`: openssl rand -hex 32
# Remove it (or leave empty) afterwards to switch the import API off.
SEED_API_TOKEN=

# Optional: outgoing email through an SMTP provider (see README "Email").
# Purelymail: SMTP_HOST=smtp.purelymail.com, SMTP_PORT=465, login = the full mailbox address.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown on emails, e.g. "Utah Valley Aeromodelers <noreply@example-club.org>"
EMAIL_FROM=
# Optional: where replies go, if not the From address
EMAIL_REPLY_TO=
# Optional test mode: send every email to this one address instead of the real recipients
EMAIL_REDIRECT_TO=

# Cloudflare Turnstile on the login and forgot-password forms (see README "Turnstile")
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
